      "title": "nodex CLI envelope"
    },
    "per_command": {
      "build": {
        "$defs": {
          "AliasedPath": {
            "description": "One name the scan holds a document under but does not use, and the one it\nuses instead.",
            "properties": {
              "named": {
                "description": "The name it carries the same document under.",
                "type": "string"
              },
              "path": {
                "description": "The name the graph does not carry.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "named"
            ],
            "type": "object"
          },
          "ParseFailure": {
            "description": "An in-scope document that failed to parse and has no node —\nfirst-class graph data, so `build` reports it structurally and the\nnode-less `parse_failure` check rule fires from it. `path` is the\nforward-slash project-root-relative path; `message` carries the\nfull error chain.",
            "properties": {
              "content_hash": {
                "description": "SHA-256 of the exact bytes the failed parse consumed (the same\ndigest the build cache keys on), so a snapshot consumer can\ndistinguish \"same broken bytes\" from \"changed since build\".\nWhen the build could not read the file at all (hard I/O\nfailure) there are no bytes to hash and this is the empty\nstring — a sentinel no real digest equals, so the status\ncontent probe can never confirm `current` for an unreadable\nfile: its state stays unconfirmable until a build can read it.",
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "message",
              "content_hash"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "`build [--full]` envelope. Full superset of\n[`crate::builder::BuildStats`] plus the CLI-measured `duration_ms`\n— the typed struct the envelope-schema entry for `build` derives\nfrom, so the schema can't drift from what the command emits.",
        "properties": {
          "aliased_paths": {
            "description": "Names the scan holds a document under but does not use, each paired\nwith the one it does. Only `scope.follow_symlinks` produces these.\nNothing is lost — the document is graphed under the name in use — so\nthis is not a decline; it is reported because a path the operator can\nread that the graph does not carry needs an explanation.",
            "items": {
              "$ref": "#/$defs/AliasedPath"
            },
            "type": "array"
          },
          "annotations": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "body_line_matches": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "cached": {
            "description": "Number of files served from the per-content-hash cache\ninstead of re-parsed. `cached + parsed == nodes` for any\nin-scope file set with no read errors.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "conditionally_excluded": {
            "description": "Project-root-relative paths a `conditional_exclude` rule dropped\nfrom scope. Empty (and omitted from JSON) when no rule fired, so\nthe exclusion is auditable rather than a silent disappearance.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "dangling_paths": {
            "description": "Paths the walk reached and could not read as a file or descend as a\ndirectory — a symlink whose target is absent, or a socket / FIFO /\ndevice node. What such an entry would have held is unknowable, so this\nis every one the walk did not keep away from rather than only those\nmatching the document globs. The build yielded nothing there, so no\nrule judged anything; reported for the same reason\n`conditionally_excluded` is, and empty (omitted) when every entry the\nwalk reached could be read or descended.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "duration_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "edges": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "escaping_paths": {
            "description": "In-scope paths a ref build dropped because they resolve outside the\ncheckout. Always empty for `nodex build`, which graphs the working\ntree and follows a symlink wherever it leads; present so a consumer\nreading a ref build sees the same accounting.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "nodes": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "parse_failures": {
            "description": "In-scope documents that failed to parse and have no node —\nmirrored from [`crate::model::Graph::parse_failures`] so the\nbuild reports every drop structurally; `check` turns the same\nrecords into Error-severity `parse_failure` violations.",
            "items": {
              "$ref": "#/$defs/ParseFailure"
            },
            "type": "array"
          },
          "parsed": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "unfollowed_paths": {
            "description": "Directory symlinks the walk did not descend, because\n`scope.follow_symlinks` is off. Nothing below them is graphed, so the\nboundary is stated instead of left to be discovered — reported for the\nsame reason `conditionally_excluded` is. Like `dangling_paths`, this is\nevery link the walk reached rather than only those that could have held\nan in-scope document: what lies below one is unknowable without\ndescending it, which is the cost the policy exists to avoid, so a link\nunder an `exclude`d tree is listed too. What the walk *does* keep away\nfrom — a `prune_dirs` basename, a hidden segment — is absent here,\nbecause that boundary is the project's own and holds for a real\ndirectory just the same.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "nodes",
          "edges",
          "annotations",
          "body_line_matches",
          "cached",
          "parsed",
          "duration_ms"
        ],
        "title": "BuildResult",
        "type": "object"
      },
      "check": {
        "$defs": {
          "BodyImmutableMode": {
            "description": "How a terminal document's body is locked.",
            "oneOf": [
              {
                "const": "frozen",
                "description": "Any body change is a violation — the document is fixed once\nit reaches terminal status. The natural mode for ADRs,\ncontracts, signed-off specs.",
                "type": "string"
              },
              {
                "const": "append_only",
                "description": "The pre-terminal body must remain an exact prefix of the new\nbody — appends are allowed, edits or deletions are not. Suits\nlog-shaped documents (changelogs, post-mortems, decision\njournals) where new entries land at the bottom.",
                "type": "string"
              }
            ]
          },
          "DriftHotspot": {
            "description": "The document that contributed the most commits to a `git_drift`\ntotal — the single edge an operator should review first.",
            "properties": {
              "commits": {
                "description": "Commits to that document since the source was reviewed.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "id": {
                "description": "Referenced document id (or raw path for an unresolved covered path).",
                "type": "string"
              }
            },
            "required": [
              "id",
              "commits"
            ],
            "type": "object"
          },
          "FieldType": {
            "description": "Accepted frontmatter field types. Covers the scalars that actually\nappear in document frontmatter. Add a variant when a real need arises —\nthe `match` statement in the validator will force every consumer to\nacknowledge the new type.",
            "enum": [
              "string",
              "integer",
              "bool",
              "date"
            ],
            "type": "string"
          },
          "ImmutableTrigger": {
            "description": "When an immutability lock engages for a document.",
            "oneOf": [
              {
                "const": "terminal",
                "description": "The lock engages once the document's *before-snapshot* status\nis terminal — the boundary `frontmatter_immutable` also reports\non, so the write that first drives a doc terminal can finalise\nit in the same edit.",
                "type": "string"
              },
              {
                "const": "creation",
                "description": "The lock engages as soon as a prior committed snapshot exists,\nregardless of status. The creating commit is structurally\nexempt: the diff layer only emits a body change for nodes\npresent in *both* snapshots, so a document's first appearance\ncan never fire the lock.",
                "type": "string"
              }
            ]
          },
          "ProposalEntry": {
            "description": "One proposed document's verdict in a `check --content` run. Each\n`--content PATH=SOURCE` pair yields one entry, in invocation order,\nso a clean or out-of-scope proposal is reported as checked rather\nthan vanishing into an empty violation list (no silent green). The\nproposal's introduced violations are not re-nested here — they live\nonce in [`CheckResult::violations`], each carrying its `path`, so a\nconsumer groups by `path` without the data being duplicated. An\nitems-list element nested in [`CheckResult::proposals`], hence the\n`*Entry` name.",
            "properties": {
              "has_path_errors": {
                "description": "`true` when an introduced Error-severity violation is *attributed to\nthis proposal's own path* (a violation whose `path` equals this\none). The name says the scope: project-wide and cross-file findings\n— a `cycle` (node-less, keyed to a ring member) or a\n`unique_numbering` collision (keyed to the first colliding path,\nwhich may be a pre-existing doc, not this proposal) — are not\nattributable to one proposal and flip no entry's flag. Treat\n[`CheckResult::violations`] (grouped by `path`) as authoritative for\nthe complete set; the run-wide gate verdict is the separate\n[`CheckResult::has_errors`].",
                "type": "boolean"
              },
              "in_scope": {
                "description": "Whether the path is in scan scope. A `false` here explains a\nclean verdict that validated nothing (nodex governs no document\nthere) — the same fact the out-of-scope warning surfaces.",
                "type": "boolean"
              },
              "path": {
                "description": "Normalized, forward-slash document path the proposed bytes target.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "in_scope",
              "has_path_errors"
            ],
            "type": "object"
          },
          "Severity": {
            "description": "Severity of a rule violation.",
            "enum": [
              "error",
              "warning"
            ],
            "type": "string"
          },
          "SkippedRule": {
            "description": "One rule that the runner declined to evaluate, with a one-line reason.\nSymmetric to [`Violation`] — silent skipping would let a strict-mode\nrule appear to \"pass\" when it never actually ran.",
            "properties": {
              "reason": {
                "type": "string"
              },
              "rule_id": {
                "type": "string"
              }
            },
            "required": [
              "rule_id",
              "reason"
            ],
            "type": "object"
          },
          "UnresolvedCause": {
            "description": "Why a reference target could not be resolved. Stable JSON surface so\nexternal tooling can branch on the cause without string-matching\n`reason` strings — and the typed vocabulary\n`[[detection.unresolved_policy]]` rows declare their `cause` in.\n\nThe resolver records a cause on every [`ResolvedTarget::Unresolved`]\nat the refusal site; the unresolved-edge classifier\n(`query::issues`) refines the path-shaped [`Self::Missing`] into\n[`Self::TargetUnparsed`] / [`Self::ExcludedFromScope`] through its\n`Graph::parse_failures` and disk probes. [`Display`] renders each\ncause's one human prose line — the single source every `reason`\nstring derives from.\n\n[`Display`]: std::fmt::Display",
            "oneOf": [
              {
                "const": "id_not_found",
                "description": "Frontmatter id relation (`supersedes` / `implements` /\n`related` / `superseded_by`) whose value isn't a known node id.",
                "type": "string"
              },
              {
                "const": "missing",
                "description": "Body-link path that resolves to no node. The build records every\nunmatched path-link with this cause (it never stats the disk);\na *reported* `Missing` has additionally survived the\nclassifier's probes, so its target corresponds to no file on\ndisk under the project root.",
                "type": "string"
              },
              {
                "const": "target_unparsed",
                "description": "Body-link path whose file is in scope but failed to parse and\nso has no node — the path is recorded in\n[`crate::model::Graph::parse_failures`]. The reference is not\nexcluded-by-design and not missing: fixing the target document\nresolves it.",
                "type": "string"
              },
              {
                "const": "excluded_from_scope",
                "description": "Body-link path whose file exists on disk but isn't in the\ngraph's scan scope — most commonly removed by\n`[[scope.conditional_exclude]]` on a terminal-status parent.",
                "type": "string"
              },
              {
                "const": "escapes_source",
                "description": "Body-link path that walks above the source file's directory\nvia `..` segments. Refused as a security guard, never resolved.",
                "type": "string"
              },
              {
                "const": "absolute",
                "description": "Body-link path written as an absolute path. Refused as out of\nproject scope.",
                "type": "string"
              }
            ]
          },
          "ValueKind": {
            "description": "The runtime shape of a JSON value, for type-mismatch reporting. A\nconsumer reads this to know what the document actually held versus\nthe declared [`FieldType`].",
            "enum": [
              "null",
              "bool",
              "integer",
              "float",
              "string",
              "array",
              "object"
            ],
            "type": "string"
          },
          "Violation": {
            "description": "A single rule violation. Every field is built only from deterministic\ngraph and config data, so two passes over one project produce the same\nfindings — which is what lets the proposal gates diff them\n([`introduced_violations`], pairing on a `finding_identity` rather than\non the whole struct: a document that moved is the same document).\n\n`message` is a rendered projection of `details`\n([`ViolationDetails::render_message`]); `details` is the typed,\nmachine-actionable cause an agent branches on. They are kept in lock\nstep by the single constructor [`Violation::new`].",
            "properties": {
              "details": {
                "$ref": "#/$defs/ViolationDetails"
              },
              "message": {
                "type": "string"
              },
              "node_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rule_id": {
                "type": "string"
              },
              "severity": {
                "$ref": "#/$defs/Severity"
              }
            },
            "required": [
              "rule_id",
              "severity",
              "message",
              "details"
            ],
            "type": "object"
          },
          "ViolationDetails": {
            "description": "The structured cause of a [`crate::rules::Violation`]. Internally tagged on\n`type`; each variant carries exactly the data its human `message`\nrenders from, so [`render_message`](Self::render_message) is a total\nfunction over the typed payload and never loses information.",
            "oneOf": [
              {
                "description": "An in-scope document failed to parse and has no node. The\n`content_digest` is the document's full content hash, so the\nviolation is exactly byte-state specific: the write-gate\nbefore/after delta only cancels a byte-identical proposal (a true\nno-op). `render_message` shows a short prefix of it; the whole\ndigest is the equality key.",
                "properties": {
                  "content_digest": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "type": {
                    "const": "parse_failure",
                    "type": "string"
